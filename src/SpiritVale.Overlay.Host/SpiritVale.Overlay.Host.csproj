<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiritVale.Overlay.Api\SpiritVale.Overlay.Api.csproj" />
    <ProjectReference Include="..\SpiritVale.Overlay.Capture\SpiritVale.Overlay.Capture.csproj" />
    <ProjectReference Include="..\SpiritVale.Overlay.Domain\SpiritVale.Overlay.Domain.csproj" />
    <ProjectReference Include="..\SpiritVale.Overlay.SamplePlugin\SpiritVale.Overlay.SamplePlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickableTransparentOverlay" Version="11.1.0" />
  </ItemGroup>

  <Target Name="PublishSamplePlugin" AfterTargets="Build">
    <PropertyGroup>
      <_PluginOut>$(OutputPath)Plugins\SpiritVale.Overlay.SamplePlugin</_PluginOut>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginOut)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\SpiritVale.Overlay.SamplePlugin\bin\$(Configuration)\net8.0\SpiritVale.Overlay.SamplePlugin.dll"
          DestinationFolder="$(_PluginOut)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\SpiritVale.Overlay.SamplePlugin\bin\$(Configuration)\net8.0\SpiritVale.Overlay.SamplePlugin.dll')" />
  </Target>

</Project>
