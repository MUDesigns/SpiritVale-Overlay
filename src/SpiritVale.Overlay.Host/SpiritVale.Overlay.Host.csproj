<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpiritVale.Overlay.Api\SpiritVale.Overlay.Api.csproj" />
    <ProjectReference Include="..\SpiritVale.Overlay.Capture\SpiritVale.Overlay.Capture.csproj" />
    <ProjectReference Include="..\SpiritVale.Overlay.Domain\SpiritVale.Overlay.Domain.csproj" />
    <ProjectReference Include="..\SpiritVale.Overlay.SamplePlugin\SpiritVale.Overlay.SamplePlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickableTransparentOverlay" Version="11.1.0" />
  </ItemGroup>

  <Target Name="PublishSamplePlugin" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_SamplePluginDll>$(MSBuildThisFileDirectory)..\SpiritVale.Overlay.SamplePlugin\bin\$(Configuration)\net8.0\SpiritVale.Overlay.SamplePlugin.dll</_SamplePluginDll>
      <_PluginOut>$(OutputPath)Plugins\SpiritVale.Overlay.SamplePlugin</_PluginOut>
      <_PublishPluginOut Condition="'$(PublishDir)' != ''">$(PublishDir)Plugins\SpiritVale.Overlay.SamplePlugin</_PublishPluginOut>
    </PropertyGroup>
    <MakeDir Directories="$(_PluginOut)" Condition="Exists('$(_SamplePluginDll)')" />
    <Copy SourceFiles="$(_SamplePluginDll)"
          DestinationFolder="$(_PluginOut)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_SamplePluginDll)')" />
    <MakeDir Directories="$(_PublishPluginOut)" Condition="'$(PublishDir)' != '' And Exists('$(_SamplePluginDll)')" />
    <Copy SourceFiles="$(_SamplePluginDll)"
          DestinationFolder="$(_PublishPluginOut)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' And Exists('$(_SamplePluginDll)')" />
  </Target>

</Project>
